# VibeVoice Environment Configuration
# Copy this file to .env and customize it for your local environment.

# --- General Settings ---
# Disable tokenizer parallelism to avoid warnings with multiprocessing
TOKENIZERS_PARALLELISM=false

# Set to 1 to run in offline mode (requires models to be pre-downloaded)
# HF_HUB_OFFLINE=0

# Custom cache directory for Hugging Face models
# HF_HOME=/path/to/your/huggingface_cache

# --- CUDA Settings (for NVIDIA GPUs) ---
# Specify which GPU(s) to use (e.g., 0, or 0,1 for multiple)
# CUDA_VISIBLE_DEVICES=0

# --- MPS Settings (for Apple Silicon) ---
# Enable fallback to CPU for unsupported MPS operations
PYTORCH_ENABLE_MPS_FALLBACK=1
# Optimize MPS memory management
PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0

# --- CPU Settings ---
# Limit the number of threads for parallel CPU operations
# OMP_NUM_THREADS=8

# --- Gradio Demo Settings ---
# Set the host for the Gradio server (0.0.0.0 to allow network access)
# GRADIO_SERVER_NAME=127.0.0.1
# Set the port for the Gradio server
# GRADIO_SERVER_PORT=7860
